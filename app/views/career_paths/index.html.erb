<div class="app-screen paths-index" data-controller="path-search">
  <header class="paths-index__header">
    <div class="brand">
      <span class="brand__badge"><i class="fa-solid fa-compass"></i></span>
      <span class="brand__name">Career Advisor</span>
    </div>
    <%= link_to edit_user_registration_path, class: "avatar-badge" do %>
      <%= current_user.email.first.upcase %>
    <% end %>
  </header>

  <p class="paths-index__date"><%= Date.current.strftime("%A, %-d %B") %></p>
  <h1 class="paths-index__greeting">Where do you want<br>to go, <%= current_user.email.split("@").first.capitalize %>?</h1>

  <div class="search-bar">
    <i class="fa-solid fa-magnifying-glass"></i>
    <input type="text"
           placeholder="Search career paths"
           data-path-search-target="input"
           data-action="input->path-search#filter">
  </div>

  <div class="section-heading">
    <h2>Explore paths</h2>
    <span class="section-heading__count">All <%= @career_paths.size %></span>
  </div>

  <ul class="path-grid" data-path-search-target="list">
    <% @career_paths.each do |career_path| %>
      <li data-path-search-target="item" data-name="<%= career_path.name.downcase %>">
        <%= link_to career_path_path(career_path), class: "path-card", style: "background-image: url('#{career_path.image_url}')" do %>
          <span class="path-card__name"><%= career_path.name %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>

<%= render "shared/bottom_nav", active: "paths" %>
