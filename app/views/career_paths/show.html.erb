<div class="row">
  <div class="col">
    <h1><%= @career_path.name %></h1>
    <%= @career_path.description %>
  </div>

  <div class="col-md-3">
    <h2>Chats</h2>

    <div class="mb-4">
      <% if @chats.any? %>
        <ul>
          <% @chats.each do |chat| %>
            <li><%= link_to chat.title, chat_path(chat) %></li>
          <% end %>
        </ul>
      <% else %>
        There are no chats yet.
      <% end %>
    </div>
    <%= button_to "New chat",
                  career_path_chats_path(@career_path),
                  class: "btn btn-primary" %>
  </div>
</div>
