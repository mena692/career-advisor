<div class="row">
  <div class="col">
    <h1><%= @career_path.name %></h1><br>
    <img src="https://res.cloudinary.com/vo8em5cs/image/upload/v1787146288/microsoft-copilot-oTDuuLUhH20-unsplash.jpg" alt="tech person" width="50%">
    <br><br><br>
    <h2>What is a <%= @career_path.name %> ?</h2><br>
    <%= @career_path.description %>
    <br><br>
    <h2>Skills required</h2>
    <ul>
      <% @career_path.skills_array.each do |skill| %>
      <li><%= skill %></li>
      <% end %>
    </ul>
  </div>

  <div class="col-md-3">
    <h2>Chats</h2>

    <div class="mb-4">
      <% if @chats.any? %>
        <ul>
          <% @chats.each do |chat| %>
            <li><%= link_to chat.title, chat_path(chat) %></li>
          <% end %>
        </ul>
      <% else %>
        There are no chats yet.
      <% end %>
    </div>
    <%= button_to "New chat",
                  career_path_chats_path(@career_path),
                  class: "btn btn-primary" %>
  </div>
</div>
