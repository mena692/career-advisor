<div class="row">
  <div class="col career">
    <%= link_to "← Back to list of career paths", career_paths_path, class: "back-button" %>
    <br><br>
    <div class="career-hero" style="background-image: url('<%= @career_path.image_url %>')">
    </div>
    <br>
    <h1>What is a <%= @career_path.name %> ?</h1><br>
    <%= @career_path.description %>
    <br><br>
    <h1>Skills required</h1><br>
    <ul class="skills-list">
      <% @career_path.skills_array.each do |skill| %>
      <li class="skill"><%= skill %></li>
      <% end %>
    </ul>
  </div>

  <div class="col-md-3">
    <h1 class="chats">Chats</h1>

    <div class="mb-4">
      <% if @chats.any? %>
        <ul class="chats-list">
          <% @chats.each do |chat| %>
            <li><%= link_to chat.title, chat_path(chat) %></li>
          <% end %>
        </ul>
      <% else %>
        There are no chats yet.
      <% end %>
    </div>
    <%= button_to "New chat",
                  career_path_chats_path(@career_path),
                  class: "new-button" %>
  </div>
</div>
