<%= simple_form_for [chat, message], html: { class: "composer" } do |f| %>
  <%= f.input :content,
            label: false,
            required: true,
            wrapper_html: { class: "composer__field" },
            input_html: { rows: 1, class: "composer__input", placeholder: "Ask about this path..." } %>
  <button type="submit" class="composer__send">
    <i class="fa-solid fa-paper-plane"></i>
  </button>
<% end %>
