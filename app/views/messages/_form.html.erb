<%= simple_form_for [chat, message] do |f| %>

  <div class="chat-form-wrapper">

    <div class="flex-grow-1">
      <%= f.input :content,
                  label: false,
                  required: true,
                  input_html: {
                    rows: 3,
                    class: "chat-input",
                    autofocus: true
                  },
                  placeholder: "Ask me anything about this career path..." %>
    </div>

    <div class="d-flex align-items-end">
      <%= f.button :submit, "Ask LLM", class: "chat-button" %>
    </div>

  </div>

<% end %>
