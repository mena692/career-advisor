<% if message.role == "user" %>
  <div class="message-row message-row--user">
    <div class="bubble bubble--user">
      <%= raw(render_markdown(message.content)) %>
    </div>
  </div>
<% elsif message.role == "assistant" %>
  <div class="message-row message-row--assistant" id="<%= dom_id(message) %>">
    <div class="bubble bubble--assistant" data-controller="copy-text">
      <div data-copy-text-target="source">
        <%= message.content.present? ? raw(render_markdown(message.content)) : "…" %>
      </div>
      <% if message.content.present? %>
        <div class="bubble__actions">
          <% if message.saved %>
            <span class="pill pill--saved"><i class="fa-solid fa-bookmark"></i> Saved</span>
          <% end %>
          <button type="button" class="pill pill--copy" data-action="copy-text#copy">
            <i class="fa-regular fa-copy"></i> <span data-copy-text-target="label">Copy</span>
          </button>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
